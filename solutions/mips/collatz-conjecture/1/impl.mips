# | Register | Usage     | Type    | Description                                       |
# | -------- | --------- | ------- | ------------------------------------------------- |
# | `$a0`    | input     | integer | starting number                                   |
# | `$v0`    | output    | integer | expected number of steps, -1 if number is invalid |
# | `$t0-9`  | temporary | any     | used for temporary storage                        |

.globl steps
steps:
    blez $a0, error_invalid_input

    move $t0, $a0                 
    li $t1, 0                      
    li $t4, 1000000               

collatz_loop:
    li $t2, 1
    beq $t0, $t2, done            

    beq $t1, $t4, error_max       

    andi $t3, $t0, 1              
    beq $t3, $zero, even_case

    mul $t0, $t0, 3
    addi $t0, $t0, 1
    j increment_step

even_case:
    srl $t0, $t0, 1

increment_step:
    addi $t1, $t1, 1
    j collatz_loop

done:
    move $v0, $t1
    jr $ra

error_invalid_input:
    li $v0, -1                    
    jr $ra

error_max:
    li $v0, -1                   
    jr $ra
